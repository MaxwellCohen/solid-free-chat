# Required for OpenRouter chat (server functions; key stays on the server).
# Use the secret from https://openrouter.ai/keys — value only, no "Bearer " prefix, no quotes.
OPENROUTER_API_KEY=

# Optional — OpenRouter app attribution (https://openrouter.ai/docs)
# OPENROUTER_HTTP_REFERER=https://your-app.com
# OPENROUTER_APP_TITLE=Solid Free Chat
